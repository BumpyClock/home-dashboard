{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame Host Sync",
  "version": "0.1.0",
  "identifier": "com.bumpyclock.frame-host-sync",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Frame Host Sync",
      "width": 520,
      "height": 680,
      "minWidth": 420,
      "minHeight": 620,
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Sync this computer to Family Frame from the system tray.",
    "category": "Utility",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
