+                let fence = address(c"eglCreateSyncKHR");
+                let poll = address(c"eglClientWaitSyncKHR");
+                let delete = address(c"eglDestroySyncKHR");
+                if ![fence, poll, delete, flush].iter().any(|p| p.is_null()) {
+                    frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "supported"), frame_trace::Field::Str("api", "egl_khr_fence_sync")]);
+                    return Some(unsafe { Self { api: FenceApi::Egl { display: raw, fence: std::mem::transmute(fence), poll: std::mem::transmute(poll), delete: std::mem::transmute(delete) }, flush: std::mem::transmute(flush) } });
+                }
+                frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "egl_fence_missing_entry_point")]);
+                return None;
+            }
+        }
+        let get_string = address(c"glGetString");
+        if get_string.is_null() {
+            frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "missing_gl_get_string")]);
+            return None;
+        }
+        let get_string: unsafe extern "system" fn(u32) -> *const u8 = unsafe { std::mem::transmute(get_string) };
+        let version = unsafe { get_string(0x1f02) };
+        if version.is_null() {
+            frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "missing_gl_version")]);
+            return None;
+        }
+        let version = unsafe { std::ffi::CStr::from_ptr(version.cast()) }.to_string_lossy();
+        let (gles, number) = if let Some(v) = version.strip_prefix("OpenGL ES ") { (true, v) } else { (false, version.as_ref()) };
+        let mut parts = number.split(|c: char| !c.is_ascii_digit());
+        let major = parts.next().and_then(|v| v.parse::<u32>().ok()).unwrap_or(0);
+        let minor = parts.next().and_then(|v| v.parse::<u32>().ok()).unwrap_or(0);
+        if (gles && major < 3) || (!gles && (major, minor) < (3, 2)) {
+            frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "unsupported_core_version_no_egl_khr_fence_sync"), frame_trace::Field::U64("major", major as u64), frame_trace::Field::U64("minor", minor as u64), frame_trace::Field::Bool("gles", gles)]);
+            return None;
+        }
+        let fence = address(c"glFenceSync");
+        let poll = address(c"glClientWaitSync");
+        let delete = address(c"glDeleteSync");
+        if [fence, poll, delete, flush].iter().any(|p| p.is_null()) {
+            frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "missing_entry_point")]);
+            return None;
+        }
+        frame_trace::event("gpu_fence_capability", None, &[frame_trace::Field::Str("status", "supported"), frame_trace::Field::Str("api", "gl_core"), frame_trace::Field::U64("major", major as u64), frame_trace::Field::U64("minor", minor as u64), frame_trace::Field::Bool("gles", gles)]);
+        Some(unsafe { Self { api: FenceApi::Gl { fence: std::mem::transmute(fence), poll: std::mem::transmute(poll), delete: std::mem::transmute(delete) }, flush: std::mem::transmute(flush) } })
+    }
+
+    fn begin(&self, id: Option<u64>) -> Option<*mut std::ffi::c_void> {
+        let fence = unsafe { match self.api {
+            FenceApi::Gl { fence, .. } => fence(0x9117, 0), // GL_SYNC_GPU_COMMANDS_COMPLETE
+            FenceApi::Egl { display, fence, .. } => fence(display, 0x30f9, std::ptr::null()), // EGL_SYNC_FENCE_KHR
+        } };
+        if fence.is_null() {
+            frame_trace::event("gpu_fence_create_failed", id, &[]);
+            return None;
+        }
+        unsafe { (self.flush)() };
+        frame_trace::event("gpu_fence_submitted", id, &[]);
+        Some(fence)
+    }
+
+    fn poll(&self, fence: *mut std::ffi::c_void, id: Option<u64>, phase: &'static str) {
+        let status = unsafe { match self.api {
+            FenceApi::Gl { poll, .. } => match poll(fence, 0, 0) {
+                0x911a | 0x911c => "signaled",
+                0x911b => "pending",
+                _ => "failed",
+            },
+            FenceApi::Egl { display, poll, .. } => match poll(display, fence, 0, 0) {
+                0x30f6 => "signaled", // EGL_CONDITION_SATISFIED_KHR
+                0x30f5 => "pending", // EGL_TIMEOUT_EXPIRED_KHR
+                _ => "failed",
+            },
+        } };
+        frame_trace::event("gpu_fence_poll", id, &[frame_trace::Field::Str("phase", phase), frame_trace::Field::Str("status", status)]);
+    }
+    fn delete(&self, fence: *mut std::ffi::c_void) {
+        unsafe { match self.api {
+            FenceApi::Gl { delete, .. } => delete(fence),
+            FenceApi::Egl { display, delete, .. } => { delete(display, fence); },
+        } }
+    }
 }
 
