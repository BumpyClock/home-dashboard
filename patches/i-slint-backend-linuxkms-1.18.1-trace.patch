+// A fence brackets GPU completion with zero-timeout polls. A flush is needed to
+// submit the fence before the DRM wait, so capture runs may perturb scheduling.
+#[derive(Clone, Copy)]
+enum FenceApi {
+    Gl {
+        fence: unsafe extern "system" fn(u32, u32) -> *mut std::ffi::c_void,
+        poll: unsafe extern "system" fn(*mut std::ffi::c_void, u32, u64) -> u32,
+        delete: unsafe extern "system" fn(*mut std::ffi::c_void),
+    },
+    Egl {
+        display: *const std::ffi::c_void,
+        fence: unsafe extern "system" fn(*const std::ffi::c_void, u32, *const i32) -> *mut std::ffi::c_void,
+        poll: unsafe extern "system" fn(*const std::ffi::c_void, *mut std::ffi::c_void, i32, u64) -> i32,
+        delete: unsafe extern "system" fn(*const std::ffi::c_void, *mut std::ffi::c_void) -> u32,
+    },
+}
+struct GpuProbe {
+    api: FenceApi,
+    flush: unsafe extern "system" fn(),
+}
+
+impl GpuProbe {
+    fn new(context: &glutin::context::PossiblyCurrentContext) -> Option<Self> {
