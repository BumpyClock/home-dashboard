import { Theme } from "theme.slint";
import { Frame, AgendaRow } from "data.slint";
import { Saver } from "saver.slint";
import { PhysicsScroll } from "scroll.slint";
import { Body, Display, Icon } from "components.slint";
import { Space, Radius, Size, Type, Alpha, Motion } from "tokens.slint";

component TodayButton inherits Rectangle {
    in property <bool> enabled;
    callback clicked();
    height: Size.button;
    min-width: content.preferred-width;
    border-radius: Radius.panel;
    border-width: focus.has-focus ? Size.line-bold : Size.line;
    border-color: focus.has-focus ? Theme.c.accent : Theme.c.line;
    background: touch.pressed ? Theme.c.surface.mix(Theme.c.bg, 1 - Alpha.pressed) : Theme.c.surface;
    animate background { duration: Theme.d(Motion.fast); }
    forward-focus: focus;
    accessible-role: button;
    accessible-label: "Back to today";
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }

    content := HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        spacing: Space.md;
        alignment: center;
        Icon {
            name: "calendar-days";
            width: Size.icon-md;
            height: Size.icon-md;
            colorize: root.enabled ? Theme.c.ink : Theme.c.muted;
            y: (parent.height - self.height) / 2;
            accessible-role: none;
        }
        Body {
            text: "Today";
            size: Type.body-l;
            font-weight: Type.weight-medium;
            color: root.enabled ? Theme.c.ink : Theme.c.muted;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
}

component CalendarEventCard inherits Rectangle {
    in property <AgendaRow> data;
    background: data.next ? Theme.c.card-hi : Theme.c.surface;
    border-radius: Radius.item;
    min-height: Size.button + Space.xl;
    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.row;
        Body {
            text: data.time;
            width: Size.calendar-time-col * Theme.scale;
            size: Type.body-l;
            font-weight: Type.weight-semibold;
            vertical-alignment: top;
            color: Theme.c.ink;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: Space.xs;
            Body {
                text: data.title;
                size: Type.title;
                font-weight: Type.weight-medium;
                wrap: word-wrap;
            }
            if data.meta != "": Body {
                text: data.meta;
                size: Type.caption;
                color: Theme.c.muted;
                wrap: word-wrap;
            }
        }
    }
}

export component CalendarScreen inherits Rectangle {
    background: Theme.c.bg;
    clip: true;
    property <bool> active: Frame.active-tab == 1 && !Saver.active;
    out property <length> scroll-offset: scroll.offset;
    forward-focus: keys;
    init => { if (active) { keys.focus(); } }
    changed active => { if (active) { keys.focus(); } }
    public function back-to-today() { scroll.scroll-to(0px); }

    Rectangle {
        width: min(root.width, Size.calendar-content-max + 2 * Space.gutter);
        height: root.height;
        x: (root.width - self.width) / 2;
        keys := FocusScope {
            enabled: root.active;
            key-pressed(event) => {
                if (event.text == Key.Home) { root.back-to-today(); return accept; }
                if (event.text == Key.End) { scroll.scroll-to(-sections.preferred-height); return accept; }
                if (event.text == Key.DownArrow) { scroll.scroll-to(scroll.offset - 2 * Size.button); return accept; }
                if (event.text == Key.UpArrow) { scroll.scroll-to(scroll.offset + 2 * Size.button); return accept; }
                if (event.text == Key.PageDown) { scroll.scroll-to(scroll.offset - scroll.height + Space.gutter); return accept; }
                if (event.text == Key.PageUp) { scroll.scroll-to(scroll.offset + scroll.height - Space.gutter); return accept; }
                return reject;
            }
            VerticalLayout {
                spacing: Space.xxl;
                padding-top: Space.gutter;
                HorizontalLayout {
                    padding-left: Space.gutter;
                    padding-right: Space.gutter;
                    spacing: Space.xl;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Space.sm;
                        Display { text: "Calendar"; size: Type.display-xl; }
                        Body { text: Frame.calendar-summary; size: Type.title; color: Theme.c.muted; wrap: word-wrap; }
                        Body { text: Frame.calendar-updated; size: Type.caption; color: Theme.c.muted; }
                        if Frame.host-calendar-hidden: Body {
                            text: Frame.host-calendar-privacy;
                            size: Type.body-l;
                            color: Theme.c.ink;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        TodayButton {
                            enabled: Frame.calendar-event-count > 0;
                            clicked => { root.back-to-today(); }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    scroll := PhysicsScroll {
                        visible: Frame.calendar-synced && Frame.calendar-event-count > 0;
                        active: root.active && self.visible;
                        sections := VerticalLayout {
                            padding-left: Space.gutter;
                            padding-right: Space.gutter;
                            padding-bottom: Space.gutter;
                            spacing: Space.page;
                            for day in Frame.calendar-days: VerticalLayout {
                                spacing: Space.lg;
                                HorizontalLayout {
                                    spacing: Space.row;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Space.xxs;
                                        Display {
                                            text: day.heading;
                                            size: Type.display-l;
                                            color: day.today ? Theme.c.accent : Theme.c.ink;
                                        }
                                        Body { text: day.date; size: Type.caption; color: Theme.c.muted; }
                                    }
                                    Body { text: day.summary; size: Type.caption; color: Theme.c.muted; vertical-alignment: center; }
                                }
                                for entry in day.events: CalendarEventCard { data: entry; }
                                if day.events.length == 0: Body {
                                    text: "No more events today.";
                                    color: Theme.c.muted;
                                    size: Type.body-l;
                                }
                            }
                        }
                    }
                    if !Frame.calendar-synced || Frame.calendar-event-count == 0: VerticalLayout {
                        alignment: center;
                        padding: Space.gutter;
                        spacing: Space.lg;
                        HorizontalLayout {
                            alignment: center;
                            Icon { name: "calendar-days"; width: Size.icon-xl; height: Size.icon-xl; colorize: Theme.c.muted; }
                        }
                        Display {
                            text: Frame.host-calendar-hidden ? "Host calendar hidden" : (Frame.calendar-synced ? "No upcoming events" : "Calendar not synced");
                            size: Type.display-l;
                            horizontal-alignment: center;
                        }
                        Body {
                            text: Frame.host-calendar-hidden ? "Unlock your computer to show its events." : (Frame.calendar-synced ? "No upcoming events in your synced calendars." : "Connect host sync to load your calendar.");
                            color: Theme.c.muted;
                            size: Type.body-l;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
