// Building blocks for the dashboard, matching pen.dev components
// (Agenda Item, Habit Row, Nav Rail) and frame sections.

import { Theme, Icons } from "theme.slint";
import { Frame, AgendaRow, Avatar, ChoreRow } from "data.slint";
import { Saver } from "saver.slint";
import { PhysicsScroll } from "scroll.slint";
import { Space, Radius, Size, Type, Alpha, Fixed, Motion } from "tokens.slint";

export component Body inherits Text {
    in property <length> size: Type.body;
    font-size: size * Theme.scale;
    font-family: Theme.font-body;
    color: Theme.c.ink;
}

export component Display inherits Text {
    in property <length> size: Type.display-l;
    font-size: size * Theme.scale;
    font-family: Theme.font-display;
    color: Theme.c.ink;
}

export component Icon inherits Image {
    in property <string> name;
    source: Icons.get(name);
    width: Size.icon-lg;
    height: Size.icon-lg;
    colorize: Theme.c.ink;
}

// Reveals + rises its content in once, after `delay`. Used for the launch
// stagger and tab entry; instant when motion is off.
export component Reveal inherits Rectangle {
    in property <duration> delay;
    in property <length> rise: Space.lg;
    property <bool> shown: !Theme.motion;
    Timer {
        interval: delay + Motion.reveal-settle;
        running: !shown && Theme.motion;
        triggered => { shown = true; }
    }
    // the offset child doesn't report its size on its own; forward it
    min-width: inner.min-width;
    min-height: inner.min-height;
    preferred-width: inner.preferred-width;
    preferred-height: inner.preferred-height;
    vertical-stretch: 0;
    inner := VerticalLayout {
        visible: shown || !Theme.motion;
        width: root.width;
        height: root.height;
        y: shown || !Theme.motion ? 0px : rise;
        animate y { duration: Theme.d(Motion.reveal-rise); easing: Motion.ease-enter; }
        @children
    }
}

// Solid dot with an optional expanding halo ("live" indicator).
export component PulseDot inherits Rectangle {
    in property <length> size: Size.dot-pulse;
    in property <color> tint: Theme.c.accent;
    in property <bool> pulsing: true;
    in property <duration> period: Motion.pulse-period;
    width: size;
    height: size;
    property <bool> ping;
    // Each urgency episode gets three pulse starts. Hidden Home and Calm/Off
    // retain pending starts and settle any active halo; returning resumes
    // the remainder without replaying a pulse that already started.
    property <int> pings;
    property <bool> animation-allowed: Theme.ambient && Frame.active-tab == 0;
    changed pulsing => { pings = 0; ping = false; }
    changed animation-allowed => {
        if (!animation-allowed) { ping = false; }
    }
    Timer {
        interval: period;
        running: pulsing && Theme.ambient && Frame.active-tab == 0 && (pings < Motion.pulse-count || ping);
        triggered => {
            ping = !ping;
            if (ping) { pings += 1; }
        }
    }
    // halo: grows + fades on each ping, snaps back while invisible
    property <length> halo: ping ? size * Size.halo-scale : size;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: halo;
        height: halo;
        border-radius: self.width / 2;
        background: tint;
        opacity: ping ? 0 : (pulsing && Theme.ambient && Frame.active-tab == 0 && pings < Motion.pulse-count ? Alpha.halo : 0);
        animate width, height, opacity { duration: ping && Frame.active-tab == 0 && Theme.ambient ? Motion.ping : 0ms; easing: Motion.ease-standard; }
    }
    Rectangle {
        border-radius: size / 2;
        background: tint;
    }
}

export component AvatarDot inherits Rectangle {
    in property <Avatar> who;
    in property <bool> past;
    width: Size.avatar;
    height: Size.avatar;
    border-radius: self.width / 2;
    background: past ? who.tint.mix(Theme.c.bg, Alpha.dim) : who.tint;
    animate background { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; }
    Body {
        text: who.initial;
        color: past ? Fixed.avatar-fg.mix(Theme.c.bg, Alpha.dim) : Fixed.avatar-fg;
        animate color { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; }
        size: Type.label;
        font-weight: Type.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AgendaCard inherits Rectangle {
    in property <AgendaRow> data;
    property <color> card-color: data.next ? Theme.c.card-hi : Theme.c.surface;
    property <color> ink: data.past ? Theme.c.ink.mix(Theme.c.bg, Alpha.dim) : Theme.c.ink;
    property <color> muted: data.past ? Theme.c.muted.mix(Theme.c.bg, Alpha.dim) : Theme.c.muted;
    background: data.past ? card-color.mix(Theme.c.bg, Alpha.dim) : card-color;
    border-radius: Radius.item;
    animate background { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; }
    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.row;
        Body {
            text: data.time;
            width: (Frame.clock24 ? Size.time-col-24h : Size.time-col-12h) * Theme.scale;
            size: Type.body;
            font-weight: Type.weight-semibold;
            color: root.ink;
            animate color { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; }
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Space.tight;
            alignment: center;
            Body { text: data.title; size: Type.title; font-weight: Type.weight-medium; color: root.ink; overflow: elide; animate color { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; } }
            Body { text: data.meta; size: Type.caption; color: root.muted; overflow: elide; animate color { duration: Theme.d(Motion.state-fade); easing: Motion.ease-state; } }
        }
        HorizontalLayout {
            spacing: Space.xs;
            for p in data.people: VerticalLayout {
                alignment: center;
                AvatarDot { who: p; past: root.data.past; }
            }
        }
    }
}

export component NowLine inherits HorizontalLayout {
    padding-left: Space.xl;
    padding-top: Space.xxs;
    padding-bottom: Space.xxs;
    spacing: Space.row;
    Body {
        text: Frame.now-short;
        width: (Frame.clock24 ? Size.time-col-24h : Size.time-col-12h) * Theme.scale;
        size: Type.caption;
        font-weight: Type.weight-semibold;
        color: Theme.c.accent;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        // static: a constant pulse would redraw all day on the frame
        PulseDot { size: Size.dot-event; pulsing: false; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle { height: Size.line-mid; background: Theme.c.accent; }
    }
}

export component SectionLabel inherits Body {
    size: Type.label;
    font-weight: Type.weight-semibold;
    letter-spacing: Type.tracking-label;
    color: Theme.c.muted;
}

// "Tomorrow" + "Shared list" cards share this shell.
export component SummaryCard inherits Rectangle {
    cache-rendering-hint: Frame.cache-dashboard;
    background: Theme.c.surface;
    border-radius: Radius.card;
    VerticalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.cozy;
        alignment: start;
        @children
    }
}

export component TomorrowCard inherits SummaryCard {
    HorizontalLayout {
        SectionLabel { text: Frame.tomorrow-label; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Body { text: Frame.tomorrow-count; size: Type.caption; color: Theme.c.muted; vertical-alignment: center; }
    }
    VerticalLayout {
        spacing: Space.sm;
        for e in Frame.tomorrow: HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                alignment: center;
                Rectangle { width: Size.dot-event; height: Size.dot-event; border-radius: Size.dot-event / 2; background: e.tint; }
            }
            Body {
                text: e.time;
                width: (Frame.clock24 ? Size.mini-time-col-24h : Size.mini-time-col-12h) * Theme.scale;
                color: Theme.c.muted;
            }
            Body { text: e.title; font-weight: Type.weight-medium; overflow: elide; horizontal-stretch: 1; }
        }
        if Frame.tomorrow.length == 0: Body { text: "Nothing planned yet."; color: Theme.c.muted; }
    }
}

export component SharedListCard inherits SummaryCard {
    HorizontalLayout {
        spacing: Space.md;
        SectionLabel { text: Frame.list-label; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        add := TouchArea {
            width: add-row.preferred-width;
            clicked => { Frame.add-item(); }
            add-row := HorizontalLayout {
                spacing: Space.xs;
                VerticalLayout {
                    alignment: center;
                    Icon { name: "plus"; width: Size.icon-xs; height: Size.icon-xs; colorize: add.pressed ? Theme.c.accent.mix(Theme.c.surface, Alpha.dim) : Theme.c.accent; }
                }
                Body { text: "Add"; size: Type.caption; font-weight: Type.weight-medium; color: add.pressed ? Theme.c.accent.mix(Theme.c.surface, Alpha.dim) : Theme.c.accent; vertical-alignment: center; }
            }
        }
    }
    VerticalLayout {
        spacing: Space.sm;
        for item[i] in Frame.list: HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Size.dot-event;
                    height: Size.dot-event;
                    border-radius: Size.dot-event / 2;
                    background: item.done ? Theme.c.line : item.tint;
                    animate background { duration: Theme.d(Motion.fast); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: label.preferred-height;
                label := Body {
                    x: 0;
                    width: self.preferred-width;
                    text: item.title;
                    font-weight: Type.weight-medium;
                    color: item.done ? Theme.c.muted : Theme.c.ink;
                    animate color { duration: Theme.d(Motion.fast); }
                }
                // strike-through that draws across on check-off
                Rectangle {
                    x: 0;
                    y: label.height / 2;
                    height: Size.line;
                    width: item.done ? label.width : 0px;
                    background: Theme.c.muted;
                    animate width { duration: Theme.d(Motion.strike); easing: Motion.ease-draw; }
                }
                TouchArea { clicked => { Frame.toggle-item(i); } }
            }
        }
    }
}

export component WeatherCard inherits Rectangle {
    cache-rendering-hint: Frame.cache-dashboard;
    background: Theme.c.weather-bg;
    border-radius: Radius.panel;
    animate background { duration: Theme.d(Motion.base); }
    VerticalLayout {
        padding-left: Space.roomy;
        padding-right: Space.roomy;
        padding-top: Space.xl;
        padding-bottom: Space.xl;
        spacing: Space.xl;
        HorizontalLayout {
            VerticalLayout {
                spacing: Space.xxs;
                alignment: center;
                Body { text: Frame.weather-line; size: Type.caption; color: Theme.c.weather-muted; }
                HorizontalLayout {
                    spacing: Space.lg;
                    alignment: start;
                    Display { text: Frame.temp; size: Type.display-xl; color: Theme.c.weather-fg; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Body { text: Frame.cond; color: Theme.c.weather-sub; }
                        Body { text: Frame.cond-sub; color: Theme.c.weather-sub; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Icon { name: Frame.weather-icon; width: Size.icon-xl; height: Size.icon-xl; colorize: Theme.c.weather-icon; }
            }
        }
        VerticalLayout {
            spacing: Space.lg;
            Rectangle { height: Size.line; background: Theme.c.weather-rule; }
            HorizontalLayout {
                for h in Frame.hourly: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.sm;
                    Body { text: h.label; size: Type.label; color: Theme.c.weather-muted; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Icon { name: h.icon; width: Size.icon-md; height: Size.icon-md; colorize: Theme.c.weather-sub; }
                    }
                    Body { text: h.temp; font-weight: Type.weight-medium; color: Theme.c.weather-fg; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Slideshow state shared by the Home card and the screensaver: which photo is
// current, which one is leaving, and the transition between them. A stage that
// isn't `live` snaps to the requested photo and runs no timer or animation.
export component PhotoStage inherits Rectangle {
    in property <bool> live;
    in property <bool> autoplay;
    in property <bool> slide;
    in property <duration> interval;
    in property <bool> ready: true;
    out property <int> current-index;
    out property <int> previous-index: -1;
    out property <bool> moving;
    out property <float> progress;
    out property <float> caption-progress;
    property <int> direction: 1;
    out property <length> current-x: slide && moving ? direction * (1 - progress) * self.width : 0px;
    out property <length> previous-x: slide && moving ? -direction * progress * self.width : 0px;
    out property <float> current-opacity: slide || !moving ? 1 : progress;
    out property <float> current-caption: moving ? caption-progress : 1;
    out property <float> previous-caption: 1 - caption-progress;
    property <int> requested-index: Frame.photo-index;
    property <bool> motion-enabled: Theme.motion;
    animate progress { duration: moving && live ? Theme.d(Motion.crossfade) : 0ms; easing: Motion.ease-crossfade; }
    animate caption-progress { duration: moving && live ? Theme.d(Motion.caption-fade) : 0ms; easing: Motion.ease-crossfade; }
    changed requested-index => {
        if (!moving) { start-transition(); }
    }
    changed ready => {
        if (ready && !moving) { start-transition(); }
    }
    changed live => {
        if (!live) { moving = false; previous-index = -1; current-index = requested-index; }
    }
    changed motion-enabled => {
        if (!motion-enabled) { moving = false; previous-index = -1; start-transition(); }
    }
    function start-transition() {
        if (requested-index == current-index) { return; }
        if (live && !ready) { return; }
        if (!Theme.motion || !live) {
            current-index = requested-index;
            previous-index = -1;
            return;
        }
        previous-index = current-index;
        direction = Frame.photo-direction;
        current-index = requested-index;
        progress = 0;
        caption-progress = 0;
        moving = true;
        progress = 1;
        caption-progress = 1;
    }
    init => { current-index = requested-index; }
    Timer {
        interval: Motion.crossfade;
        running: moving && live;
        triggered => { moving = false; previous-index = -1; }
    }
    // Coalesce rapid taps to the latest requested photo after the current
    // transition, so every tap counts without drawing a third image.
    Timer {
        interval: 1ms;
        running: live && ready && !moving && current-index != requested-index;
        triggered => { start-transition(); }
    }
    Timer {
        interval: root.interval;
        running: live && autoplay && !Frame.night-active && !Frame.benchmark-mode && Frame.photos.length > 1 && !moving && current-index == requested-index;
        triggered => {
            Frame.photo-direction = 1;
            Frame.photo-index = Math.mod(Frame.photo-index + 1, Frame.photos.length);
        }
    }
}

// Home slideshow card: crossfade or slide, tap to advance. Rust pre-scales
// photos to this card's exact pixel size (see `photo-size-changed`), so drawing
// is a 1:1 blit instead of a per-frame resample; only the two photos involved
// in a transition are drawn. (Ken Burns drift was removed: ~78% CPU continuous
// with the software renderer.)
export component PhotoCard inherits PhotoStage {
    ready: Frame.photos[Frame.photo-index].image.width > 0;
    // Rectangular clipping uses a scissor; the page-colored ring below
    // masks rounded corners without an offscreen layer for the whole card.
    clip: true;
    background: Frame.photos.length > 0 ? transparent : Theme.c.line;
    live: Frame.active-tab == 0 && !Saver.active;
    autoplay: Theme.ambient;
    slide: Frame.photo-transition-slide;
    interval: Motion.slideshow-interval;
    property <string> displayed: "\{root.current-index} \{root.previous-index} \{root.moving ? 1 : 0} \{root.live ? 1 : 0}";
    function report-displayed() {
        Saver.card-current = root.live ? root.current-index : -1;
        Saver.card-previous = root.live && root.moving ? root.previous-index : -1;
    }
    changed displayed => { report-displayed(); }
    property <length> physical-pixel: 1phx;
    function report-size() {
        Frame.photo-card-width = root.width / 1px;
        Frame.photo-card-height = root.height / 1px;
        Frame.photo-scrim-height = min(Size.photo-scrim, root.height) / 1px;
        Frame.photo-size-changed(root.width, root.height, min(Size.photo-scrim, root.height));
    }
    changed width => { report-size(); }
    changed height => { report-size(); }
    changed physical-pixel => { report-size(); }
    init => { report-size(); report-displayed(); }
    // Completed photos use unit physical scaling. During a resize, old
    // photos still cover the card until the replacement decode arrives.
    Image {
        source: Frame.photos[root.previous-index].image;
        image-fit: cover;
        width: max(self.source.width * 1phx, parent.width);
        height: max(self.source.height * 1phx, parent.height);
        x: root.previous-x;
        visible: root.moving;
    }
    Image {
        source: Frame.photos[root.current-index].image;
        image-fit: cover;
        width: max(self.source.width * 1phx, parent.width);
        height: max(self.source.height * 1phx, parent.height);
        x: root.current-x;
        opacity: root.current-opacity;
    }
    // Rasterized once by the SVG image cache; no positioned offscreen layer.
    Image {
        y: parent.height - self.height;
        width: parent.width;
        height: min(Size.photo-scrim, parent.height);
        source: @image-url("images/photo-scrim.svg");
        image-fit: fill;
        visible: !Frame.photo-scrim-baked;
    }
    for index[k] in [root.previous-index, root.current-index]: Display {
        y: parent.height - self.preferred-height - Space.xl;
        x: Space.inset;
        width: parent.width - Space.inset - Size.photo-caption-gap;
        text: Frame.photos[index].title;
        size: Type.display-m;
        color: Fixed.photo-fg;
        overflow: elide;
        visible: k == 1 || root.moving;
        opacity: k == 1 ? root.current-caption : root.previous-caption;
    }
    // Dots only fit a small set; a long photo library shows none.
    if Frame.photos.length <= 12: HorizontalLayout {
        x: parent.width - self.preferred-width - Space.inset;
        y: parent.height - Space.xxl;
        width: self.preferred-width;
        height: Size.pager-dot;
        spacing: Size.pager-dot;
        for p[i] in Frame.photos: Rectangle {
            width: i == Frame.photo-index ? Size.pager-dot-active : Size.pager-dot;
            border-radius: Size.pager-dot / 2;
            background: i == Frame.photo-index ? Fixed.photo-fg : Fixed.pager-idle;
            animate width, background { duration: Theme.d(Motion.pager); easing: Motion.ease-spring-pop; }
        }
    }
    if Frame.photos.length == 0: Body {
        text: Frame.photos-loading ? "Loading photos…" : "No photos yet";
        color: Theme.c.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    // Rounded corners: a page-colored ring masks the rectangular photo clip.
    Rectangle {
        x: -Radius.panel;
        y: -Radius.panel;
        width: parent.width + 2 * Radius.panel;
        height: parent.height + 2 * Radius.panel;
        border-radius: 2 * Radius.panel;
        border-width: Radius.panel;
        border-color: Theme.c.bg;
    }
    TouchArea {
        clicked => {
            if (Frame.photos.length > 0) {
                Frame.photo-direction = 1;
                Frame.photo-index = Math.mod(Frame.photo-index + 1, Frame.photos.length);
            }
        }
    }
}

export component ChoreDot inherits Rectangle {
    in property <int> state;
    in property <color> tint;
    width: Size.dot-chore;
    height: Size.dot-chore;
    border-radius: Size.dot-chore / 2;
    background: state == 1 ? tint : (state == 2 ? transparent : Theme.c.dot-empty);
    border-width: state == 2 ? Size.line-mid : 0px;
    border-color: tint;
    animate background { duration: Theme.d(Motion.base); easing: Motion.ease-standard; }
}

export component ChoresBlock inherits VerticalLayout {
    padding-left: Space.xs;
    padding-right: Space.xs;
    padding-top: Space.xs;
    spacing: Space.lg;
    property <[string]> letters: ["M", "T", "W", "T", "F", "S", "S"];
    HorizontalLayout {
        spacing: Space.lg;
        padding-bottom: Space.xs;
        Display { text: "Chores"; size: Type.display-m; horizontal-stretch: 1; vertical-alignment: bottom; }
        VerticalLayout {
            alignment: end;
            padding-bottom: Space.xs;
            HorizontalLayout {
                spacing: Space.sm;
                for l[i] in letters: Text {
                    text: l;
                    width: Size.dot-chore;
                    font-size: Type.micro;
                    font-weight: Type.weight-semibold;
                    font-family: Theme.font-body;
                    horizontal-alignment: center;
                    color: i == Frame.today-index ? Theme.c.accent : Theme.c.muted;
                }
            }
        }
        Rectangle { width: Size.chore-who-col * Theme.scale; }
    }
    for c[ci] in Frame.chores: TouchArea {
        clicked => { Frame.toggle-chore(ci); }
        HorizontalLayout {
            spacing: Space.lg;
            Body { text: c.name; size: Type.body-l; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
            HorizontalLayout {
                spacing: Space.sm;
                for d in c.days: VerticalLayout {
                    alignment: center;
                    ChoreDot { state: d.state; tint: d.tint; }
                }
            }
            Body {
                text: c.who;
                width: Size.chore-who-col * Theme.scale;
                size: Type.caption;
                font-weight: Type.weight-medium;
                color: c.tint;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component Header inherits HorizontalLayout {
    spacing: Space.xl;
    VerticalLayout {
        spacing: Space.sm;
        alignment: end;
        Body { text: Frame.dateline; size: Type.caption; font-weight: Type.weight-semibold; letter-spacing: Type.tracking-wide; color: Theme.c.muted; }
        Display { text: Frame.greeting; size: Type.display-xl; overflow: elide; }
        HorizontalLayout {
            spacing: Space.md;
            alignment: start;
            VerticalLayout {
                alignment: center;
                PulseDot { size: Size.dot-pulse; pulsing: Frame.urgent; period: Motion.pulse-period-urgent; }
            }
            Body { text: Frame.next-up; size: Type.body-l; font-weight: Type.weight-medium; color: Theme.c.accent; }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: end;
        HorizontalLayout {
            alignment: end;
            spacing: Space.sm;
            Display { text: Frame.clock; size: Type.clock; }
            if !Frame.clock24: VerticalLayout {
                alignment: end;
                padding-bottom: Space.row;
                Body { text: Frame.ampm; size: Type.meridiem; color: Theme.c.muted; }
            }
        }
    }
}

// Agenda: header, scrolling event list with the live "now" line, summary cards.
export component Agenda inherits VerticalLayout {
    spacing: Space.md;
    HorizontalLayout {
        cache-rendering-hint: Frame.cache-main-content;
        padding-bottom: Space.md;
        Display { text: "Today"; size: Type.display-l; vertical-alignment: bottom; }
        Rectangle { horizontal-stretch: 1; }
        Body { text: Frame.agenda-summary; color: Theme.c.muted; vertical-alignment: bottom; }
    }
    // Past events sit above the now line and are scrolled out of view, so
    // the next event is at the top. Drag to look back; it springs back after
    // 15 s idle, and glides on when an event ends.
    list := PhysicsScroll {
        active: Frame.active-tab == 0;
        vertical-stretch: 1;
        // extra room so the now line can reach the top even when little is left
        min-content-height: past.preferred-height + rows.spacing + self.height;
        // offset that puts the now line at the top of the list
        property <length> target: -(past.preferred-height + rows.spacing);
        property <bool> idle: true;
        property <bool> ready;
        changed target => { if (self.idle && self.ready) { self.scroll-to(self.target); } }
        user-scrolled => { self.idle = false; }
        Timer {
            interval: Motion.scroll-ready;
            running: Frame.active-tab == 0 && !list.ready;
            triggered => { list.ready = true; list.scroll-to(list.target); }
        }
        Timer {
            interval: Motion.scroll-idle-return;
            running: Frame.active-tab == 0 && !list.idle && !list.dragging;
            triggered => { list.idle = true; list.scroll-to(list.target); }
        }
        rows := VerticalLayout {
            // Offset belongs to PhysicsScroll's parent layout, so this cache
            // holds all rows while the viewport translates and clips its quad.
            cache-rendering-hint: Frame.cache-main-content && self.width <= 4096phx && self.height <= 4096phx;
            spacing: Space.md;
            alignment: start;
            past := VerticalLayout {
                spacing: Space.md;
                for row in Frame.agenda-past: AgendaCard { data: row; }
            }
            if Frame.agenda-past.length > 0 || Frame.agenda-next.length > 0: NowLine { }
            upcoming := VerticalLayout {
                spacing: Space.md;
                for row[i] in Frame.agenda-next: Reveal {
                    delay: Motion.agenda-first + i * Motion.agenda-step;
                    AgendaCard { data: row; }
                }
                if Frame.agenda-next.length == 0: Reveal {
                    delay: Motion.agenda-first;
                    Rectangle {
                        border-radius: Radius.item;
                        border-width: Size.line;
                        border-color: Theme.c.line;
                        VerticalLayout {
                            padding: Space.roomy;
                            spacing: Space.xs;
                            Body { text: Frame.agenda-done; size: Type.title; font-weight: Type.weight-medium; }
                            Body { text: Frame.agenda-done-sub; size: Type.caption; color: Theme.c.muted; }
                        }
                    }
                }
            }
        }
    }
    Reveal {
        delay: Motion.delay-summary;
        HorizontalLayout {
            spacing: Space.lg;
            TomorrowCard { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
            SharedListCard { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
        }
    }
}
