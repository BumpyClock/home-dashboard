import { Theme, Icons } from "theme.slint";
import { Frame, AgendaRow, Avatar, ChoreRow } from "data.slint";
import { Saver } from "saver.slint";
import { PhysicsScroll } from "scroll.slint";
import { Space, Radius, Size, Type, Alpha, Fixed, Motion } from "tokens.slint";

export component Body inherits Text {
    in property <length> size: Type.body;
    font-size: size * Theme.scale;
    font-family: Theme.font-body;
    color: Theme.c.ink;
}

export component Display inherits Text {
    in property <length> size: Type.display-l;
    font-size: size * Theme.scale;
    font-family: Theme.font-display;
    color: Theme.c.ink;
}

export component Icon inherits Image {
    in property <string> name;
    source: Icons.get(name);
    width: Size.icon-lg;
    height: Size.icon-lg;
    colorize: Theme.c.ink;
}

export component StaticDot inherits Rectangle {
    in property <length> size: Size.dot-event;
    in property <color> tint: Theme.c.accent;
    width: size;
    height: size;
    border-radius: size / 2;
    background: tint;
}

export component PulseDot inherits Rectangle {
    in property <length> size: Size.dot-pulse;
    in property <color> tint: Theme.c.accent;
    in property <bool> pulsing: true;
    in property <duration> period: Motion.pulse-period;
    width: size;
    height: size;
    property <bool> ping;
    property <bool> animation-allowed: Theme.ambient && Frame.active-tab == 0;
    property <int> episode-pings;
    property <bool> episode-spent: episode-pings >= Motion.pulse-count;
    changed pulsing => { episode-pings = 0; ping = false; }
    changed animation-allowed => {
        if (!animation-allowed) { ping = false; }
    }
    Timer {
        interval: period;
        running: pulsing && animation-allowed && (!episode-spent || ping);
        triggered => {
            ping = !ping;
            if (ping) { episode-pings += 1; }
        }
    }
    property <length> halo: ping ? size * Size.halo-scale : size;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: halo;
        height: halo;
        border-radius: self.width / 2;
        background: tint;
        opacity: ping ? 0 : (pulsing && animation-allowed && !episode-spent ? Alpha.halo : 0);
        animate width, height, opacity { duration: ping && animation-allowed ? Motion.ping : 0ms; easing: Motion.ease-standard; }
    }
    StaticDot { size: root.size; tint: root.tint; }
}

export component AvatarDot inherits Rectangle {
    in property <Avatar> who;
    in property <bool> past;
    width: Size.avatar;
    height: Size.avatar;
    border-radius: self.width / 2;
    background: past ? who.tint.mix(Theme.c.bg, Alpha.dim) : who.tint;
    Body {
        text: who.initial;
        color: past ? Fixed.avatar-fg.mix(Theme.c.bg, Alpha.dim) : Fixed.avatar-fg;
        size: Type.label;
        font-weight: Type.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component AgendaCard inherits Rectangle {
    in property <AgendaRow> data;
    property <color> card-color: data.next ? Theme.c.card-hi : Theme.c.surface;
    property <color> ink: data.past ? Theme.c.ink.mix(Theme.c.bg, Alpha.dim) : Theme.c.ink;
    property <color> muted: data.past ? Theme.c.muted.mix(Theme.c.bg, Alpha.dim) : Theme.c.muted;
    background: data.past ? card-color.mix(Theme.c.bg, Alpha.dim) : card-color;
    border-radius: Radius.item;
    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.row;
        Body {
            text: data.time;
            width: (Frame.clock24 ? Size.time-col-24h : Size.time-col-12h) * Theme.scale;
            size: Type.body;
            font-weight: Type.weight-semibold;
            color: root.ink;
                vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Space.tight;
            alignment: center;
            Body { text: data.title; size: Type.title; font-weight: Type.weight-medium; color: root.ink; overflow: elide; }
            Body { text: data.meta; size: Type.caption; color: root.muted; overflow: elide; }
        }
        HorizontalLayout {
            spacing: Space.xs;
            for p in data.people: VerticalLayout {
                alignment: center;
                AvatarDot { who: p; past: root.data.past; }
            }
        }
    }
}

export component NowLine inherits HorizontalLayout {
    padding-left: Space.xl;
    padding-top: Space.xxs;
    padding-bottom: Space.xxs;
    spacing: Space.row;
    Body {
        text: Frame.now-short;
        width: (Frame.clock24 ? Size.time-col-24h : Size.time-col-12h) * Theme.scale;
        size: Type.caption;
        font-weight: Type.weight-semibold;
        color: Theme.c.accent;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        StaticDot { }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Rectangle { height: Size.line-mid; background: Theme.c.accent; }
    }
}

export component SectionLabel inherits Body {
    size: Type.label;
    font-weight: Type.weight-semibold;
    letter-spacing: Type.tracking-label;
    color: Theme.c.muted;
}

export component SummaryCard inherits Rectangle {
    cache-rendering-hint: Frame.cache-dashboard;
    background: Theme.c.surface;
    border-radius: Radius.card;
    VerticalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.lg;
        padding-bottom: Space.lg;
        spacing: Space.cozy;
        alignment: start;
        @children
    }
}

export component TomorrowCard inherits SummaryCard {
    HorizontalLayout {
        SectionLabel { text: Frame.tomorrow-label; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Body { text: Frame.tomorrow-count; size: Type.caption; color: Theme.c.muted; vertical-alignment: center; }
    }
    VerticalLayout {
        spacing: Space.sm;
        for e in Frame.tomorrow: HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                alignment: center;
                StaticDot { tint: e.tint; }
            }
            Body {
                text: e.time;
                width: (Frame.clock24 ? Size.mini-time-col-24h : Size.mini-time-col-12h) * Theme.scale;
                color: Theme.c.muted;
            }
            Body { text: e.title; font-weight: Type.weight-medium; overflow: elide; horizontal-stretch: 1; }
        }
        if Frame.tomorrow.length == 0: Body { text: "Nothing planned yet."; color: Theme.c.muted; }
    }
}

export component SharedListCard inherits SummaryCard {
    HorizontalLayout {
        spacing: Space.md;
        SectionLabel { text: Frame.list-label; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        add := TouchArea {
            width: add-row.preferred-width;
            clicked => { Frame.add-item(); }
            add-row := HorizontalLayout {
                spacing: Space.xs;
                VerticalLayout {
                    alignment: center;
                    Icon { name: "plus"; width: Size.icon-xs; height: Size.icon-xs; colorize: add.pressed ? Theme.c.accent.mix(Theme.c.surface, Alpha.dim) : Theme.c.accent; }
                }
                Body { text: "Add"; size: Type.caption; font-weight: Type.weight-medium; color: add.pressed ? Theme.c.accent.mix(Theme.c.surface, Alpha.dim) : Theme.c.accent; vertical-alignment: center; }
            }
        }
    }
    VerticalLayout {
        spacing: Space.sm;
        for item[i] in Frame.list: HorizontalLayout {
            spacing: Space.md;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: Size.dot-event;
                    height: Size.dot-event;
                    border-radius: Size.dot-event / 2;
                    background: item.done ? Theme.c.line : item.tint;
                    animate background { duration: Theme.d(Motion.fast); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: label.preferred-height;
                label := Body {
                    x: 0;
                    width: self.preferred-width;
                    text: item.title;
                    font-weight: Type.weight-medium;
                    color: item.done ? Theme.c.muted : Theme.c.ink;
                    animate color { duration: Theme.d(Motion.fast); }
                }
                Rectangle {
                    x: 0;
                    y: label.height / 2;
                    height: Size.line;
                    width: item.done ? label.width : 0px;
                    background: Theme.c.muted;
                    animate width { duration: Theme.d(Motion.strike); easing: Motion.ease-draw; }
                }
                TouchArea { clicked => { Frame.toggle-item(i); } }
            }
        }
    }
}

export component WeatherCard inherits Rectangle {
    cache-rendering-hint: Frame.cache-dashboard;
    background: Theme.c.weather-bg;
    border-radius: Radius.panel;
    animate background { duration: Theme.d(Motion.base); }
    VerticalLayout {
        padding-left: Space.roomy;
        padding-right: Space.roomy;
        padding-top: Space.xl;
        padding-bottom: Space.xl;
        spacing: Space.xl;
        HorizontalLayout {
            VerticalLayout {
                spacing: Space.xxs;
                alignment: center;
                Body { text: Frame.weather-line; size: Type.caption; color: Theme.c.weather-muted; }
                HorizontalLayout {
                    spacing: Space.lg;
                    alignment: start;
                    Display { text: Frame.temp; size: Type.display-xl; color: Theme.c.weather-fg; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Body { text: Frame.cond; color: Theme.c.weather-sub; }
                        Body { text: Frame.cond-sub; color: Theme.c.weather-sub; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Icon { name: Frame.weather-icon; width: Size.icon-xl; height: Size.icon-xl; colorize: Theme.c.weather-icon; }
            }
        }
        VerticalLayout {
            spacing: Space.lg;
            Rectangle { height: Size.line; background: Theme.c.weather-rule; }
            HorizontalLayout {
                for h in Frame.hourly: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.sm;
                    Body { text: h.label; size: Type.label; color: Theme.c.weather-muted; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Icon { name: h.icon; width: Size.icon-md; height: Size.icon-md; colorize: Theme.c.weather-sub; }
                    }
                    Body { text: h.temp; font-weight: Type.weight-medium; color: Theme.c.weather-fg; horizontal-alignment: center; }
                }
            }
        }
    }
}

export component PhotoStage inherits Rectangle {
    in property <bool> running;
    in property <int> trace-kind;
    in property <bool> autoplay;
    in property <bool> slide;
    in property <duration> interval;
    in property <bool> ready: true;
    out property <int> current-index: current-slot-1 ? slot-1-index : slot-0-index;
    out property <int> previous-index: moving ? (current-slot-1 ? slot-0-index : slot-1-index) : -1;
    out property <int> slot-0-index;
    out property <int> slot-1-index: -1;
    out property <bool> current-slot-1;
    out property <bool> moving;
    out property <float> progress;
    property <int> direction: 1;
    out property <length> current-x: slide && moving ? direction * (1 - progress) * self.width : 0px;
    out property <length> previous-x: slide && moving ? -direction * progress * self.width : 0px;
    out property <float> current-opacity: slide || !moving ? 1 : progress;
    property <int> requested-index: Frame.photo-index;
    property <bool> pending: current-index != requested-index;
    property <bool> motion-enabled: Theme.motion;
    property <bool> snap: !running || !Theme.motion;
    animate progress { duration: moving && running ? Theme.d(Motion.photo-transition) : 0ms; easing: Motion.ease-photo; }
    function trace-stage(event: int) {
        Frame.trace-photo-stage(trace-kind, event, requested-index, current-index, previous-index, ready);
    }
    changed requested-index => {
        trace-stage(0);
        if (!moving) { start-transition(); }
    }
    changed ready => {
        trace-stage(1);
        if (ready && !moving) { start-transition(); }
    }
    changed running => {
        if (!running) { if (moving) { trace-stage(3); } moving = false; if (current-slot-1) { slot-1-index = requested-index; } else { slot-0-index = requested-index; } }
    }
    changed motion-enabled => {
        if (!motion-enabled) { if (moving) { trace-stage(3); } moving = false; start-transition(); }
    }
    function start-transition() {
        if (requested-index == current-index) { return; }
        if (running && !ready) { return; }
        if (snap) {
            if (current-slot-1) { slot-1-index = requested-index; } else { slot-0-index = requested-index; }
            trace-stage(4);
            return;
        }
        direction = Frame.photo-direction;
        if (current-slot-1) { slot-0-index = requested-index; } else { slot-1-index = requested-index; }
        current-slot-1 = !current-slot-1;
        progress = 0;
        moving = true;
        trace-stage(2);
        progress = 1;
    }
    init => { slot-0-index = requested-index; trace-stage(6); }
    Timer {
        interval: Motion.photo-transition;
        running: moving && root.running;
        triggered => { trace-stage(5); moving = false; }
    }
    Timer {
        interval: Motion.coalesce;
        running: root.running && ready && !moving && pending;
        triggered => { start-transition(); }
    }
    Timer {
        interval: root.interval;
        running: root.running && autoplay && !Frame.night-active && !Frame.benchmark-mode && Frame.photos.length > 1 && !moving && !pending;
        triggered => {
            Frame.photo-direction = 1;
            Frame.photo-index = Math.mod(Frame.photo-index + 1, Frame.photos.length);
        }
    }
}

// Paints the area outside a rounded rect in `ring-color`, so an unclipped child looks
// rounded without a rounded `clip`, which FemtoVG renders through an offscreen layer.
// `ring` must be at least 0.42 × `radius` to cover the corners.
export component RoundedCornerMask inherits Rectangle {
    in property <length> inner-width;
    in property <length> inner-height;
    in property <length> radius: Radius.panel;
    in property <length> ring: Radius.panel;
    in property <color> ring-color: Theme.c.bg;
    x: -ring;
    y: -ring;
    width: inner-width + 2 * ring;
    height: inner-height + 2 * ring;
    border-radius: radius + ring;
    border-width: ring;
    border-color: ring-color;
}

export component PhotoCard inherits PhotoStage {
    ready: Frame.photos[Frame.photo-index].image.width > 0;
    clip: true;
    background: Frame.photos.length > 0 ? transparent : Theme.c.line;
    running: Frame.active-tab == 0 && !Saver.active;
    autoplay: Theme.ambient;
    slide: Frame.photo-transition-slide;
    interval: Motion.slideshow-interval;
    property <{current: int, previous: int}> displayed: {
        current: root.running ? root.current-index : -1,
        previous: root.running && root.moving ? root.previous-index : -1,
    };
    function report-displayed() {
        Saver.card-current = displayed.current;
        Saver.card-previous = displayed.previous;
    }
    changed displayed => { report-displayed(); }
    property <length> physical-pixel: 1phx;
    property <int> pager-photo-limit: 12;
    pure function prescaled-extent(source: image, at-least: length) -> length {
        return max(source.width * 1phx, at-least);
    }
    function report-size() {
        Frame.photo-card-width = root.width / 1px;
        Frame.photo-card-height = root.height / 1px;
        Frame.photo-scrim-height = min(Size.photo-scrim, root.height) / 1px;
        Frame.photo-size-changed(root.width, root.height, min(Size.photo-scrim, root.height));
    }
    changed width => { report-size(); }
    changed height => { report-size(); }
    changed physical-pixel => { report-size(); }
    init => { report-size(); report-displayed(); }
    Image {
        source: Frame.photos[root.slot-0-index].image;
        image-fit: cover;
        width: prescaled-extent(self.source, parent.width);
        height: prescaled-extent(self.source, parent.height);
        x: root.current-slot-1 ? root.previous-x : root.current-x;
        opacity: root.current-slot-1 ? 1 : root.current-opacity;
        visible: !root.current-slot-1 || root.moving;
        z: root.current-slot-1 ? 0 : 1;
    }
    Image {
        source: Frame.photos[root.slot-1-index].image;
        image-fit: cover;
        width: prescaled-extent(self.source, parent.width);
        height: prescaled-extent(self.source, parent.height);
        x: root.current-slot-1 ? root.current-x : root.previous-x;
        opacity: root.current-slot-1 ? root.current-opacity : 1;
        visible: root.current-slot-1 || root.moving;
        z: root.current-slot-1 ? 1 : 0;
    }
    Image {
        y: parent.height - self.height;
        width: parent.width;
        height: min(Size.photo-scrim, parent.height);
        z: 2;
        source: @image-url("images/photo-scrim.svg");
        image-fit: fill;
        visible: !Frame.photo-scrim-baked;
    }
    Display {
        y: parent.height - self.preferred-height - Space.xl;
        x: Space.photo-inset;
        width: parent.width - Space.photo-inset - Size.photo-caption-gap;
        z: 2;
        text: Frame.photos[root.current-index].title;
        size: Type.display-m;
        color: Fixed.photo-fg;
        overflow: elide;
    }
    if Frame.photos.length <= pager-photo-limit: HorizontalLayout {
        z: 2;
        x: parent.width - self.preferred-width - Space.photo-inset;
        y: parent.height - Space.xxl;
        width: self.preferred-width;
        height: Size.pager-dot;
        spacing: Size.pager-dot;
        for p[i] in Frame.photos: Rectangle {
            width: i == Frame.photo-index ? Size.pager-dot-active : Size.pager-dot;
            border-radius: Size.pager-dot / 2;
            background: i == Frame.photo-index ? Fixed.photo-fg : Fixed.pager-idle;
        }
    }
    if Frame.photos.length == 0: Body {
        z: 2;
        text: Frame.photos-loading ? "Loading photos…" : "No photos yet";
        color: Theme.c.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    RoundedCornerMask { z: 2; inner-width: parent.width; inner-height: parent.height; }
    TouchArea {
        clicked => {
            if (Frame.photos.length > 0) {
                Frame.photo-direction = 1;
                Frame.photo-index = Math.mod(Frame.photo-index + 1, Frame.photos.length);
            }
        }
    }
}

export component ChoreDot inherits Rectangle {
    in property <int> state;
    in property <color> tint;
    width: Size.chore-day-cell;
    height: Size.chore-day-cell;
    border-radius: Size.chore-day-cell / 2;
    background: state == 1 ? tint : (state == 2 ? transparent : Theme.c.dot-empty);
    border-width: state == 2 ? Size.line-mid : 0px;
    border-color: tint;
    animate background { duration: Theme.d(Motion.base); easing: Motion.ease-standard; }
}

export component ChoresBlock inherits VerticalLayout {
    padding-left: Space.xs;
    padding-right: Space.xs;
    padding-top: Space.xs;
    spacing: Space.lg;
    property <[string]> letters: ["M", "T", "W", "T", "F", "S", "S"];
    HorizontalLayout {
        spacing: Space.lg;
        padding-bottom: Space.xs;
        Display { text: "Chores"; size: Type.display-m; horizontal-stretch: 1; vertical-alignment: bottom; }
        VerticalLayout {
            alignment: end;
            padding-bottom: Space.xs;
            HorizontalLayout {
                spacing: Space.sm;
                for l[i] in letters: Text {
                    text: l;
                    width: Size.chore-day-cell;
                    font-size: Type.micro;
                    font-weight: Type.weight-semibold;
                    font-family: Theme.font-body;
                    horizontal-alignment: center;
                    color: i == Frame.today-index ? Theme.c.accent : Theme.c.muted;
                }
            }
        }
        Rectangle { width: Size.chore-who-col * Theme.scale; }
    }
    for c[ci] in Frame.chores: TouchArea {
        clicked => { Frame.toggle-chore(ci); }
        HorizontalLayout {
            spacing: Space.lg;
            Body { text: c.name; size: Type.body-l; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
            HorizontalLayout {
                spacing: Space.sm;
                for d in c.days: VerticalLayout {
                    alignment: center;
                    ChoreDot { state: d.state; tint: d.tint; }
                }
            }
            Body {
                text: c.who;
                width: Size.chore-who-col * Theme.scale;
                size: Type.caption;
                font-weight: Type.weight-medium;
                color: c.tint;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

export component Header inherits HorizontalLayout {
    spacing: Space.xl;
    VerticalLayout {
        spacing: Space.sm;
        alignment: end;
        Body { text: Frame.dateline; size: Type.caption; font-weight: Type.weight-semibold; letter-spacing: Type.tracking-wide; color: Theme.c.muted; }
        Display { text: Frame.greeting; size: Type.display-xl; overflow: elide; }
        HorizontalLayout {
            spacing: Space.md;
            alignment: start;
            VerticalLayout {
                alignment: center;
                PulseDot { size: Size.dot-pulse; pulsing: Frame.urgent; period: Motion.pulse-period-urgent; }
            }
            Body { text: Frame.next-up; size: Type.body-l; font-weight: Type.weight-medium; color: Theme.c.accent; }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: end;
        HorizontalLayout {
            alignment: end;
            spacing: Space.sm;
            Display { text: Frame.clock; size: Type.clock; }
            if !Frame.clock24: VerticalLayout {
                alignment: end;
                padding-bottom: Space.row;
                Body { text: Frame.ampm; size: Type.meridiem; color: Theme.c.muted; }
            }
        }
    }
}

export component Agenda inherits VerticalLayout {
    spacing: Space.md;
    HorizontalLayout {
        cache-rendering-hint: Frame.cache-main-content;
        padding-bottom: Space.md;
        Display { text: "Today"; size: Type.display-l; vertical-alignment: bottom; }
        Rectangle { horizontal-stretch: 1; }
        Body { text: Frame.agenda-summary; color: Theme.c.muted; vertical-alignment: bottom; }
    }
    list := PhysicsScroll {
        active: Frame.active-tab == 0;
        cache-content: Frame.cache-main-content;
        vertical-stretch: 1;
        property <length> now-line-offset: past.preferred-height + rows.spacing;
        min-content-height: now-line-offset + self.height;
        property <length> target: -now-line-offset;
        property <bool> idle: true;
        property <bool> ready;
        changed target => { if (self.idle && self.ready) { self.scroll-to(self.target); } }
        user-scrolled => { self.idle = false; }
        Timer {
            interval: Motion.scroll-ready;
            running: Frame.active-tab == 0 && !list.ready;
            triggered => { list.ready = true; list.scroll-to(list.target); }
        }
        Timer {
            interval: Motion.scroll-idle-return;
            running: Frame.active-tab == 0 && !list.idle && !list.dragging;
            triggered => { list.idle = true; list.scroll-to(list.target); }
        }
        rows := VerticalLayout {
            spacing: Space.md;
            alignment: start;
            past := VerticalLayout {
                spacing: Space.md;
                for row in Frame.agenda-past: AgendaCard { data: row; }
            }
            if Frame.agenda-past.length > 0 || Frame.agenda-current.length > 0: NowLine { }
            upcoming := VerticalLayout {
                spacing: Space.md;
                for row in Frame.agenda-current: AgendaCard { data: row; }
                if Frame.agenda-current.length == 0: Rectangle {
                    border-radius: Radius.item;
                    border-width: Size.line;
                    border-color: Theme.c.line;
                    VerticalLayout {
                        padding: Space.roomy;
                        spacing: Space.xs;
                        Body { text: Frame.agenda-done; size: Type.title; font-weight: Type.weight-medium; }
                        Body { text: Frame.agenda-done-sub; size: Type.caption; color: Theme.c.muted; }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Space.lg;
        TomorrowCard { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
        SharedListCard { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
    }
}
