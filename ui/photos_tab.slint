import { Theme } from "theme.slint";
import { Frame } from "data.slint";
import { Saver } from "saver.slint";
import { PhysicsScroll } from "scroll.slint";
import { Display, Body, Icon, RoundedCornerMask } from "components.slint";
import { Space, Radius, Size, Type, Fixed } from "tokens.slint";

export component PhotosScreen inherits Rectangle {
    clip: true;
    background: Theme.c.bg;

    property <length> gap: Space.row;
    property <length> pad: Space.gutter;
    property <int> cols: max(2, Math.floor((scroll.width - 2 * pad + gap) / (Size.photo-tile-min + gap)));
    property <length> tile: (scroll.width - 2 * pad - (cols - 1) * gap) / cols;
    property <length> pitch: tile + gap;
    property <int> decode-lag-rows: 1;
    property <int> decode-lead-rows: 3;
    property <int> first: max(0, Math.floor(-scroll.offset / pitch) - decode-lag-rows) * cols;
    property <int> end: min(Frame.photos.length, (Math.floor((-scroll.offset + scroll.height) / pitch) + decode-lead-rows) * cols);
    // Fixed tile pool: slot j always shows the photo congruent to j modulo pool-size, so
    // scrolling one row reassigns only that row's slots. A reassigned Image uploads a new
    // texture, because pixel-buffer images have no shared texture cache.
    property <int> pool-size: (Math.ceil(scroll.height / pitch) + 1 + decode-lag-rows + decode-lead-rows) * cols;
    function report() {
        Saver.grid-first = first;
        Saver.grid-end = end;
    }
    changed first => { report(); }
    changed end => { report(); }
    init => { report(); }

    VerticalLayout {
        spacing: Space.xl;
        HorizontalLayout {
            padding: pad;
            padding-bottom: 0px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Display { text: "Photos"; size: Type.display-xl; }
                Body { text: "\{Frame.photos.length} photos"; size: Type.title; color: Theme.c.muted; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: Size.button;
                    border-radius: self.height / 2;
                    background: start.pressed ? Theme.c.accent.darker(0.15) : Theme.c.accent;
                    HorizontalLayout {
                        padding-left: Space.xxl;
                        padding-right: Space.xxl;
                        spacing: Space.md;
                        alignment: center;
                        Icon { name: "play"; width: Size.icon-md; height: Size.icon-md; colorize: Fixed.photo-fg; y: (parent.height - self.height) / 2; }
                        Body { text: "Start slideshow"; size: Type.body-l; font-weight: Type.weight-semibold; color: Fixed.photo-fg; vertical-alignment: center; }
                    }
                    start := TouchArea {
                        enabled: Frame.photos.length > 0;
                        clicked => { Saver.active = true; }
                    }
                }
            }
        }
        scroll := PhysicsScroll {
            vertical-stretch: 1;
            tapped(x, y) => {
                let col = Math.floor((x - pad) / pitch);
                let row = Math.floor(y / pitch);
                let i = row * cols + col;
                let tile-x = x - pad - col * pitch;
                let tile-y = y - row * pitch;
                if (row >= 0 && col >= 0 && col < cols && tile-x >= 0px && tile-x < tile && tile-y >= 0px && tile-y < tile && i >= 0 && i < Frame.photos.length) {
                    Frame.photo-direction = 1;
                    Frame.photo-index = i;
                    Saver.active = true;
                }
            }
            Rectangle {
                height: Frame.photos.length > 0 ? Math.ceil(Frame.photos.length / cols) * pitch + pad : scroll.height;
                for slot[j] in root.pool-size: Rectangle {
                    property <int> photo-index: root.first + Math.mod(j + root.pool-size - Math.mod(root.first, root.pool-size), root.pool-size);
                    visible: photo-index < root.end;
                    x: pad + Math.mod(photo-index, cols) * pitch;
                    y: Math.floor(photo-index / cols) * pitch;
                    width: tile;
                    height: tile;
                    border-radius: Radius.item;
                    background: Theme.c.line;
                    Image { source: Frame.photos[parent.photo-index].thumb; image-fit: cover; width: parent.width; height: parent.height; }
                    RoundedCornerMask {
                        inner-width: parent.width;
                        inner-height: parent.height;
                        radius: Radius.item;
                        ring: Space.sm;
                        ring-color: Theme.c.bg;
                    }
                    Rectangle {
                        border-radius: parent.border-radius;
                        border-width: parent.photo-index == Frame.photo-index ? Size.line-bold : 0px;
                        border-color: Theme.c.accent;
                    }
                }
                if Frame.photos.length == 0: Body {
                    text: Frame.photos-loading ? "Loading photos…" : "No photos yet";
                    color: Theme.c.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }
    }
}
