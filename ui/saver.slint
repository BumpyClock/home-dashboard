export global Saver {
    in-out property <bool> active;
    in-out property <int> grid-first;
    in-out property <int> grid-end;
    in-out property <int> card-current: -1;
    in-out property <int> card-previous: -1;
    in-out property <int> full-current: -1;
    in-out property <int> full-previous: -1;
    in-out property <int> pixel-width;
    in-out property <int> pixel-height;
    callback demand();
    callback swiped(float, float);
}
