import { Theme } from "theme.slint";
import { Frame } from "data.slint";
import { Saver } from "saver.slint";
import { Display, Body, Icon, PhotoStage } from "components.slint";
import { Space, Size, Type, Alpha, Fixed, Motion, Physics } from "tokens.slint";

component TimeBlock inherits HorizontalLayout {
    spacing: Space.md;
    alignment: start;
    Display { text: Frame.clock; size: Type.saver-clock; color: Fixed.photo-fg; }
    VerticalLayout {
        alignment: end;
        padding-bottom: Space.section;
        Display { text: Frame.clock24 ? "" : Frame.ampm; size: Type.display-xl; color: Fixed.photo-fg-muted; }
    }
}

component Glance inherits VerticalLayout {
    spacing: Space.md;
    alignment: end;
    HorizontalLayout {
        spacing: Space.lg;
        alignment: end;
        Icon { name: Frame.weather-icon; width: Size.icon-saver; height: Size.icon-saver; colorize: Fixed.photo-fg; }
        Display { text: Frame.temp; size: Type.display-xl; color: Fixed.photo-fg; }
    }
    Body {
        text: Frame.next-up;
        size: Type.title;
        font-weight: Type.weight-semibold;
        color: Fixed.photo-fg;
        horizontal-alignment: right;
        overflow: elide;
    }
    Body {
        text: Frame.photos[Frame.photo-index].title;
        size: Type.body-l;
        color: Fixed.photo-fg-muted;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component Screensaver inherits PhotoStage {
    ready: Frame.photos[Frame.photo-index].full.width > 0;
    running: true;
    autoplay: Theme.ambient;
    slide: Frame.photo-transition-slide;
    interval: Motion.screensaver-interval;
    background: Fixed.black;
    property <bool> wide: self.width > self.height;
    property <{current: int, previous: int}> displayed: {
        current: root.current-index,
        previous: root.moving ? root.previous-index : -1,
    };
    function report-displayed() {
        Saver.full-current = displayed.current;
        Saver.full-previous = displayed.previous;
    }
    changed displayed => { report-displayed(); }
    init => { report-displayed(); }
    pure function best-available(i: int) -> image {
        return Frame.photos[i].full.width > 0 ? Frame.photos[i].full
            : Frame.photos[i].thumb.width > 0 ? Frame.photos[i].thumb : Frame.photos[i].image;
    }
    Image {
        source: best-available(root.previous-index);
        image-fit: cover;
        width: parent.width;
        height: parent.height;
        x: root.previous-x;
        visible: root.moving;
    }
    Image {
        source: best-available(root.current-index);
        image-fit: cover;
        width: parent.width;
        height: parent.height;
        x: root.current-x;
        opacity: root.current-opacity;
    }
    Rectangle { background: Fixed.black; opacity: Alpha.night-dim; visible: Frame.night-active; }
    if wide: HorizontalLayout {
        padding: Space.saver;
        VerticalLayout {
            alignment: end;
            TimeBlock { }
        }
        Rectangle { horizontal-stretch: 1; }
        Glance { width: Size.saver-glance; }
    }
    if !wide: HorizontalLayout {
        padding: Space.saver;
        spacing: Space.xxl;
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: end;
            TimeBlock { }
        }
        Glance { horizontal-stretch: 1; }
    }
    property <length> press-x;
    property <length> press-y;
    property <bool> dragged;
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.dragged = false;
            } else if (e.kind == PointerEventKind.up) {
                Saver.swiped((self.mouse-x - root.press-x) / 1px, (self.mouse-y - root.press-y) / 1px);
            } else if (e.kind == PointerEventKind.cancel) {
                root.dragged = true;
            }
        }
        moved => {
            if (self.pressed && (abs(self.mouse-x - root.press-x) >= Physics.tap-slop || abs(self.mouse-y - root.press-y) >= Physics.tap-slop)) {
                root.dragged = true;
            }
        }
        clicked => {
            if (!root.dragged && abs(self.mouse-x - root.press-x) < Physics.tap-slop && abs(self.mouse-y - root.press-y) < Physics.tap-slop) {
                Saver.active = false;
            }
        }
    }
}

export component SaverLayer inherits Rectangle {
    clip: true;
    property <{photo-index: int, saver-active: bool, tab: int, grid-first: int, grid-end: int, card-current: int, card-previous: int, full-current: int, full-previous: int, pixel-width: int, pixel-height: int}> demand-inputs: {
        photo-index: Frame.photo-index,
        saver-active: Saver.active,
        tab: Frame.active-tab,
        grid-first: Saver.grid-first,
        grid-end: Saver.grid-end,
        card-current: Saver.card-current,
        card-previous: Saver.card-previous,
        full-current: Saver.full-current,
        full-previous: Saver.full-previous,
        pixel-width: Saver.pixel-width,
        pixel-height: Saver.pixel-height,
    };
    function report-size() {
        Saver.pixel-width = Math.ceil(self.width / 1phx);
        Saver.pixel-height = Math.ceil(self.height / 1phx);
    }
    property <bool> active: Saver.active;
    changed active => {
        if (!active) { Saver.full-current = -1; Saver.full-previous = -1; }
    }
    changed width => { report-size(); }
    changed height => { report-size(); }
    changed demand-inputs => { Saver.demand(); }
    init => { report-size(); Saver.demand(); }
    if Saver.active: Screensaver { }
}
