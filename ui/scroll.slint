// Momentum scroller with some physical weight: drag 1:1, coast with
// friction after release, rubber-band past the ends, and settle on a
// slightly under-damped spring. `scroll-to()` uses the same spring, so
// programmatic moves feel like the content was pushed, not tweened.
//
// Closed-form motion is sampled at animation frames; idle reads no animation clock.
// Use for content without its own touch targets (taps are not forwarded).

import { Theme } from "theme.slint";
import { Physics } from "tokens.slint";

enum ScrollMode { idle, coasting, spring }

export component PhysicsScroll inherits Rectangle {
    in property <length> min-content-height;
    in property <bool> active: true;
    in property <bool> cache-content: false;
    out property <length> offset: mode == ScrollMode.idle ? position : (mode == ScrollMode.coasting ? clamp-y(sample-position(elapsed)) : sample-position(elapsed));
    out property <bool> dragging: ta.pressed;
    callback user-scrolled();
    // content-space press position, for releases that did not drag
    callback tapped(length, length);

    clip: true;
    property <length> content-h: max(inner.preferred-height, min-content-height);
    property <length> lo: min(0px, root.height - content-h);
    property <length> hi: 0px;

    property <float> velocity-px-per-ms;
    property <length> position;
    property <ScrollMode> mode;
    property <length> anchor;
    property <length> last-y;
    property <length> down-y;
    property <length> down-x;
    property <bool> tap-moved;
    property <bool> pressed-during-motion;
    property <duration> last-t;
    property <duration> motion-t;
    property <bool> motion-enabled: Theme.motion;
    property <duration> elapsed: active && motion-enabled && mode != ScrollMode.idle ? max(0ms, animation-tick() - motion-t) : 0ms;
    property <float> coast-rate: -ln(Physics.friction-per-step) / (Physics.step / 1ms);
    property <float> decay: Physics.damping-per-ms / 2;
    property <float> frequency: sqrt(max(Physics.stiffness-per-ms2 - decay * decay, Physics.under-damped-floor-per-ms2));

    function clamp-y(y: length) -> length { return max(lo, min(hi, y)); }

    changed active => {
        if (!active) {
            interrupt-motion();
            velocity-px-per-ms = 0;
            position = clamp-y(position);
        }
    }
    changed motion-enabled => {
        if (!motion-enabled) {
            interrupt-motion();
            velocity-px-per-ms = 0;
            position = clamp-y(position);
        }
    }
    changed lo => {
        if (mode == ScrollMode.spring && anchor != clamp-y(anchor)) {
            let target = clamp-y(anchor);
            interrupt-motion();
            anchor = target;
            start-motion(ScrollMode.spring);
        } else if (mode == ScrollMode.idle && !ta.pressed) {
            position = clamp-y(position);
        }
    }

    function start-motion(next: ScrollMode) {
        if (!active || !motion-enabled) {
            position = clamp-y(position);
            mode = ScrollMode.idle;
            velocity-px-per-ms = 0;
            return;
        }
        let spring = next == ScrollMode.spring || position < lo || position > hi;
        if (spring && next != ScrollMode.spring) { anchor = clamp-y(position); }
        if (spring && abs((position - anchor) / 1px) < Physics.settle-distance-px && abs(velocity-px-per-ms) < Physics.settle-speed-px-per-ms) {
            position = anchor;
            velocity-px-per-ms = 0;
            return;
        }
        if (!spring && abs(velocity-px-per-ms) < Physics.coast-stop-px-per-ms) { velocity-px-per-ms = 0; return; }
        motion-t = animation-tick();
        mode = spring ? ScrollMode.spring : ScrollMode.coasting;
    }

    function sample-position(dt: duration) -> length {
        let ms = dt / 1ms;
        if (mode == ScrollMode.coasting) {
            return position + velocity-px-per-ms / coast-rate * (1 - exp(-coast-rate * ms)) * 1px;
        }
        if (mode == ScrollMode.spring) {
            let x = (position - anchor) / 1px;
            let b = (velocity-px-per-ms + decay * x) / frequency;
            let phase = frequency * ms * 180deg / 3.141592653589793;
            return anchor + exp(-decay * ms) * (x * cos(phase) + b * sin(phase)) * 1px;
        }
        return position;
    }

    function sample-velocity(dt: duration) -> float {
        let ms = dt / 1ms;
        if (mode == ScrollMode.coasting) { return velocity-px-per-ms * exp(-coast-rate * ms); }
        if (mode == ScrollMode.spring) {
            let x = (position - anchor) / 1px;
            let b = (velocity-px-per-ms + decay * x) / frequency;
            let phase = frequency * ms * 180deg / 3.141592653589793;
            return exp(-decay * ms) * (velocity-px-per-ms * cos(phase) - (decay * b + frequency * x) * sin(phase));
        }
        return velocity-px-per-ms;
    }

    function interrupt-motion() {
        if (mode == ScrollMode.idle) { return; }
        let dt = max(0ms, animation-tick() - motion-t);
        let current = mode == ScrollMode.coasting ? clamp-y(sample-position(dt)) : sample-position(dt);
        let velocity = sample-velocity(dt);
        mode = ScrollMode.idle;
        position = current;
        velocity-px-per-ms = velocity;
    }

    changed elapsed => {
        if (active && motion-enabled && mode != ScrollMode.idle) {
            let current = sample-position(elapsed);
            let velocity = sample-velocity(elapsed);
            if (mode == ScrollMode.coasting && (current < lo || current > hi || abs(velocity) < Physics.coast-stop-px-per-ms)) {
                position = clamp-y(current);
                mode = ScrollMode.idle;
                velocity-px-per-ms = 0;
            } else if (mode == ScrollMode.spring && abs(velocity) < Physics.settle-speed-px-per-ms && abs((current - anchor) / 1px) < Physics.settle-distance-px) {
                position = anchor;
                mode = ScrollMode.idle;
                velocity-px-per-ms = 0;
            }
        }
    }

    public function scroll-to(y: length) {
        interrupt-motion();
        if (!active || !motion-enabled) {
            mode = ScrollMode.idle;
            velocity-px-per-ms = 0;
            position = clamp-y(y);
            return;
        }
        anchor = clamp-y(y);
        start-motion(ScrollMode.spring);
    }

    inner := VerticalLayout {
        y: root.offset;
        width: root.width;
        height: self.preferred-height;
        cache-rendering-hint: cache-content && self.width <= 4096phx && self.height <= 4096phx;
        @children
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                pressed-during-motion = mode != ScrollMode.idle;
                interrupt-motion();
                velocity-px-per-ms = 0;
                down-y = self.mouse-y;
                down-x = self.mouse-x;
                tap-moved = false;
                last-y = self.mouse-y;
                last-t = animation-tick();
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                start-motion(ScrollMode.coasting);
            }
        }
        clicked => {
            if (!pressed-during-motion && !tap-moved && abs(self.mouse-y - down-y) < Physics.tap-slop && abs(self.mouse-x - down-x) < Physics.tap-slop) {
                root.tapped(self.mouse-x, self.mouse-y - root.offset);
            }
        }
        moved => {
            if (self.pressed) {
                if (abs(self.mouse-x - down-x) >= Physics.tap-slop || abs(self.mouse-y - down-y) >= Physics.tap-slop) { tap-moved = true; }
                let dy = self.mouse-y - last-y;
                let dt = max(1ms, animation-tick() - last-t);
                let out = position > hi || position < lo;
                position += out ? dy * Physics.edge-resist : dy;
                velocity-px-per-ms = velocity-px-per-ms * Physics.release-keep + (dy / 1px) / (dt / 1ms) * Physics.release-new;
                last-y = self.mouse-y;
                last-t = animation-tick();
                root.user-scrolled();
            }
        }
        scroll-event(e) => {
            interrupt-motion();
            let out = position > hi || position < lo;
            position += out ? e.delta-y * Physics.edge-resist : e.delta-y;
            velocity-px-per-ms = 0;
            anchor = clamp-y(position);
            start-motion(ScrollMode.spring);
            root.user-scrolled();
            accept
        }
    }

}
