// Momentum scroller with some physical weight: drag 1:1, coast with
// friction after release, rubber-band past the ends, and settle on a
// slightly under-damped spring. `scroll-to()` uses the same spring, so
// programmatic moves feel like the content was pushed, not tweened.
//
// Closed-form motion is sampled at animation frames; idle reads no animation clock.
// Use for content without its own touch targets (taps are not forwarded).

import { Theme } from "theme.slint";
import { Physics } from "tokens.slint";

export component PhysicsScroll inherits Rectangle {
    // extra scrollable room below the content (e.g. so a row can reach the top)
    in property <length> min-content-height;
    in property <bool> active: true;
    out property <length> offset: mode == 0 ? position : (mode == 1 ? clamp-y(sample-position(elapsed)) : sample-position(elapsed));
    out property <bool> dragging: ta.pressed;
    callback user-scrolled();
    // content-space press position, for releases that did not drag
    callback tapped(length, length);

    clip: true;
    property <length> content-h: max(inner.preferred-height, min-content-height);
    property <length> lo: min(0px, root.height - content-h);
    property <length> hi: 0px;

    // motion state; velocity in px per ms
    property <float> v;
    property <length> position;
    property <int> mode;          // 0 idle, 1 coasting, 2 spring to `anchor`
    property <length> anchor;
    property <length> last-y;
    property <length> down-y;
    property <length> down-x;
    property <bool> tap-moved;
    property <bool> catching;  // the press stopped a coasting list, so it is not a tap
    property <duration> last-t;
    property <duration> motion-t;
    property <bool> motion-enabled: Theme.motion;
    property <duration> elapsed: active && motion-enabled && mode != 0 ? max(0ms, animation-tick() - motion-t) : 0ms;
    property <float> coast-rate: -ln(Physics.friction) / (Physics.step / 1ms);
    property <float> decay: Physics.damping / 2;
    // The fixed Physics tokens select an underdamped spring.
    property <float> frequency: sqrt(Physics.stiffness - decay * decay);

    function clamp-y(y: length) -> length { return max(lo, min(hi, y)); }

    changed active => {
        if (!active) {
            interrupt-motion();
            v = 0;
            position = clamp-y(position);
        }
    }
    changed motion-enabled => {
        if (!motion-enabled) {
            interrupt-motion();
            v = 0;
            position = clamp-y(position);
        }
    }
    changed lo => {
        if (mode == 2 && anchor != clamp-y(anchor)) {
            let target = clamp-y(anchor);
            interrupt-motion();
            anchor = target;
            start-motion(2);
        } else if (mode == 0 && !ta.pressed) {
            position = clamp-y(position);
        }
    }

    function start-motion(next: int) {
        if (!active || !motion-enabled) {
            position = clamp-y(position);
            mode = 0;
            v = 0;
            return;
        }
        let spring = next == 2 || position < lo || position > hi;
        if (spring && next != 2) { anchor = clamp-y(position); }
        if (spring && abs((position - anchor) / 1px) < Physics.settle-distance && abs(v) < Physics.settle-speed) {
            position = anchor;
            v = 0;
            return;
        }
        if (!spring && abs(v) < Physics.coast-stop) { v = 0; return; }
        motion-t = animation-tick();
        mode = spring ? 2 : 1;
    }

    function sample-position(dt: duration) -> length {
        let ms = dt / 1ms;
        if (mode == 1) {
            return position + v / coast-rate * (1 - exp(-coast-rate * ms)) * 1px;
        }
        if (mode == 2) {
            let x = (position - anchor) / 1px;
            let b = (v + decay * x) / frequency;
            let phase = frequency * ms * 180deg / 3.141592653589793;
            return anchor + exp(-decay * ms) * (x * cos(phase) + b * sin(phase)) * 1px;
        }
        return position;
    }

    function sample-velocity(dt: duration) -> float {
        let ms = dt / 1ms;
        if (mode == 1) { return v * exp(-coast-rate * ms); }
        if (mode == 2) {
            let x = (position - anchor) / 1px;
            let b = (v + decay * x) / frequency;
            let phase = frequency * ms * 180deg / 3.141592653589793;
            return exp(-decay * ms) * (v * cos(phase) - (decay * b + frequency * x) * sin(phase));
        }
        return v;
    }

    function interrupt-motion() {
        if (mode == 0) { return; }
        let dt = max(0ms, animation-tick() - motion-t);
        let current = mode == 1 ? clamp-y(sample-position(dt)) : sample-position(dt);
        let velocity = sample-velocity(dt);
        mode = 0;
        position = current;
        v = velocity;
    }

    changed elapsed => {
        if (active && motion-enabled && mode != 0) {
            let current = sample-position(elapsed);
            let velocity = sample-velocity(elapsed);
            if (mode == 1 && (current < lo || current > hi || abs(velocity) < Physics.coast-stop)) {
                position = clamp-y(current);
                mode = 0;
                v = 0;
            } else if (mode == 2 && abs(velocity) < Physics.settle-speed && abs((current - anchor) / 1px) < Physics.settle-distance) {
                position = anchor;
                mode = 0;
                v = 0;
            }
        }
    }

    public function scroll-to(y: length) {
        interrupt-motion();
        if (!active || !motion-enabled) {
            mode = 0;
            v = 0;
            position = clamp-y(y);
            return;
        }
        anchor = clamp-y(y);
        start-motion(2);
    }

    inner := VerticalLayout {
        y: root.offset;
        width: root.width;
        height: self.preferred-height;
        @children
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                catching = mode != 0;
                interrupt-motion();
                v = 0;
                down-y = self.mouse-y;
                down-x = self.mouse-x;
                tap-moved = false;
                last-y = self.mouse-y;
                last-t = animation-tick();
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                start-motion(1);
            }
        }
        clicked => {
            if (!catching && !tap-moved && abs(self.mouse-y - down-y) < Physics.tap-slop && abs(self.mouse-x - down-x) < Physics.tap-slop) {
                root.tapped(self.mouse-x, self.mouse-y - root.offset);
            }
        }
        moved => {
            if (self.pressed) {
                if (abs(self.mouse-x - down-x) >= Physics.tap-slop || abs(self.mouse-y - down-y) >= Physics.tap-slop) { tap-moved = true; }
                let dy = self.mouse-y - last-y;
                let dt = max(1ms, animation-tick() - last-t);
                let out = position > hi || position < lo;
                position += out ? dy * Physics.edge-resist : dy;
                // smoothed release velocity
                v = v * Physics.release-keep + (dy / 1px) / (dt / 1ms) * Physics.release-new;
                last-y = self.mouse-y;
                last-t = animation-tick();
                root.user-scrolled();
            }
        }
        scroll-event(e) => {
            interrupt-motion();
            let out = position > hi || position < lo;
            position += out ? e.delta-y * Physics.edge-resist : e.delta-y;
            v = 0;
            // let the edge spring pull it back once the wheel stops
            anchor = clamp-y(position);
            start-motion(2);
            root.user-scrolled();
            accept
        }
    }

}
